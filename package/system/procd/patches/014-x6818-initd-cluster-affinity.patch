+/* Restrict x6818 init scripts to one cluster until cross-cluster userspace
+ * corruption is resolved. PID1 and unrelated boards keep their affinity. */
+static int initd_cluster_affinity(void)
+{
+#ifdef X6818_INITD_SINGLE_CLUSTER
+	char compatible[512];
+	ssize_t len;
+	int fd, cpu;
+	cpu_set_t inherited, mask;
+
+	fd = open("/proc/device-tree/compatible", O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return 0;
+	len = read(fd, compatible, sizeof(compatible));
+	close(fd);
+	if (len <= 0)
+		return 0;
+	bool x6818 = false;
+	for (ssize_t offset = 0; offset < len;) {
+		size_t size = strnlen(compatible + offset, len - offset);
+		if (size == (size_t)(len - offset))
+			break;
+		if (!strcmp(compatible + offset, "nexell,x6818"))
+			x6818 = true;
+		offset += size + 1;
+	}
+	if (!x6818)
+		return 0;
+	if (sched_getaffinity(0, sizeof(inherited), &inherited))
+		return -1;
+	CPU_ZERO(&mask);
+	for (cpu = 0; cpu < 4; cpu++)
+		if (CPU_ISSET(cpu, &inherited))
+			CPU_SET(cpu, &mask);
+	return sched_setaffinity(0, sizeof(mask), &mask);
+#else
+	return 0;
+#endif
+}
+
 static void q_initd_run(struct runqueue *q, struct runqueue_task *t)
 {
