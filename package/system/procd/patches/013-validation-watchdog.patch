--- a/system.c
+++ b/system.c
@@ -22,6 +22,7 @@
 #include <sys/stat.h>
 #include <sys/statvfs.h>
 #include <fcntl.h>
+#include <poll.h>
 #include <signal.h>
 #include <unistd.h>
 #include <stdlib.h>
@@ -603,7 +604,8 @@
 	char buf[64] = { 0 };
 	json_tokener *tok;
 	ssize_t len;
-	int _errno;
+	int _errno, ready;
+	struct pollfd pfd = { .fd = fd, .events = POLLIN };
 
 	tok = json_tokener_new();
 	if (!tok)
@@ -611,7 +613,25 @@
 
 	vjson_error(err, "incomplete JSON input");
 
-	while ((len = read(fd, buf, sizeof(buf)))) {
+	/* Validation can take longer than the hardware watchdog timeout.
+	 * Keep feeding it while waiting synchronously for the validator.
+	 * Do not dispatch nested ubus requests: they share the result buffer.
+	 */
+	for (;;) {
+		watchdog_ping();
+		ready = poll(&pfd, 1, 1000);
+		if (!ready || (ready < 0 && errno == EINTR))
+			continue;
+		if (ready < 0 || (pfd.revents & POLLNVAL)) {
+			_errno = ready < 0 ? errno : EBADF;
+			json_tokener_free(tok);
+			return vjson_error(err, "poll() failed: %s (%d)",
+					   strerror(_errno), _errno);
+		}
+
+		len = read(fd, buf, sizeof(buf));
+		if (!len)
+			break;
 		if (len < 0 && errno == EINTR)
 			continue;
 
