--- a/upgraded/upgraded.c
+++ b/upgraded/upgraded.c
@@ -15,6 +15,10 @@
 #define _GNU_SOURCE
 
 #include <sys/reboot.h>
+#ifdef UPGRADE_FAILURE_RECOVERY
+#include <sys/ioctl.h>
+#include <sys/wait.h>
+#endif
 
 #include <fcntl.h>
 #include <stdio.h>
@@ -32,12 +36,87 @@
 #endif
 
 static struct uloop_process upgrade_proc;
+#ifdef UPGRADE_FAILURE_RECOVERY
+static struct uloop_process recovery_proc;
+static int recovery_started;
+static int upgrade_status = EXIT_FAILURE;
+static struct uloop_timeout upgrade_poll;
+static void upgrade_proc_cb(struct uloop_process *proc, int ret);
+
+static void recovery_proc_cb(struct uloop_process *proc, int ret)
+{
+	fprintf(stderr, "Recovery shell exited (%d); watchdog remains serviced.\n", ret);
+}
+
+static void upgrade_recovery(void)
+{
+	if (recovery_started)
+		return;
+	recovery_started = 1;
+	fprintf(stderr, "Upgrade failed; automatic reboot inhibited. "
+		"Use the console to recover before rebooting.\n");
+	recovery_proc.cb = recovery_proc_cb;
+	recovery_proc.pid = fork();
+	if (recovery_proc.pid < 0) {
+		fprintf(stderr, "Failed to fork recovery shell: %m\n");
+		return;
+	}
+	if (!recovery_proc.pid) {
+		int fd;
+
+		if (setsid() < 0)
+			_exit(EXIT_FAILURE);
+		fd = open("/dev/console", O_RDWR);
+		if (fd < 0)
+			_exit(EXIT_FAILURE);
+		if (dup2(fd, STDIN_FILENO) < 0 ||
+		    dup2(fd, STDOUT_FILENO) < 0 ||
+		    dup2(fd, STDERR_FILENO) < 0)
+			_exit(EXIT_FAILURE);
+		(void)ioctl(STDIN_FILENO, TIOCSCTTY, 0);
+		if (fd > STDERR_FILENO)
+			close(fd);
+		execl("/bin/ash", "ash", "-i", NULL);
+		_exit(EXIT_FAILURE);
+	}
+	if (uloop_process_add(&recovery_proc) < 0)
+		fprintf(stderr, "Failed to watch recovery shell: %m\n");
+}
+static void upgrade_poll_cb(struct uloop_timeout *t)
+{
+	int status;
+	pid_t pid = waitpid(upgrade_proc.pid, &status, WNOHANG);
+
+	if (pid == upgrade_proc.pid) {
+		upgrade_proc_cb(&upgrade_proc, status);
+		return;
+	}
+	if (pid < 0 && errno == ECHILD) {
+		/* This PID came from our successful fork. No child remains;
+		 * an unavailable exit status is failure, never upgrade success.
+		 */
+		fprintf(stderr, "Upgrade writer already reaped; exit status unavailable\n");
+		upgrade_proc_cb(&upgrade_proc, EXIT_FAILURE);
+		return;
+	}
+	/* EINTR and other transient wait errors do not establish termination. */
+	uloop_timeout_set(t, 1000);
+}
+#endif
 unsigned int debug = 2;
 
 static void upgrade_proc_cb(struct uloop_process *proc, int ret)
 {
-	if (ret)
+#ifdef UPGRADE_FAILURE_RECOVERY
+	upgrade_status = ret;
+#endif
+	if (ret) {
 		fprintf(stderr, "sysupgrade aborted with return code: %d\n", ret);
+#ifdef UPGRADE_FAILURE_RECOVERY
+		upgrade_recovery();
+		return;
+#endif
+	}
 	uloop_end();
 }
 
@@ -49,6 +128,10 @@
 	upgrade_proc.pid = fork();
 	if (upgrade_proc.pid < 0) {
 		fprintf(stderr, "Failed to fork sysupgrade\n");
+#ifdef UPGRADE_FAILURE_RECOVERY
+		upgrade_recovery();
+		uloop_run();
+#endif
 		return;
 	}
 
@@ -59,7 +142,18 @@
 		_exit(EXIT_FAILURE);
 	}
 
+#ifdef UPGRADE_FAILURE_RECOVERY
+	if (uloop_process_add(&upgrade_proc) < 0) {
+		fprintf(stderr, "Failed to watch sysupgrade; automatic reboot inhibited\n");
+		/* Poll to establish writer termination before opening recovery. */
+		upgrade_poll.cb = upgrade_poll_cb;
+		uloop_timeout_set(&upgrade_poll, 1000);
+		uloop_run();
+		return;
+	}
+#else
 	uloop_process_add(&upgrade_proc);
+#endif
 	uloop_run();
 }
 
@@ -97,6 +191,11 @@
 	uloop_init();
 	watchdog_init(0);
 	sysupgrade(argv[1], argv[2]);
+#ifdef UPGRADE_FAILURE_RECOVERY
+	/* A signal or unexpected loop return must not boot a failed upgrade. */
+	while (upgrade_status != 0)
+		uloop_run();
+#endif
 
 	reboot(RB_AUTOBOOT);
 
