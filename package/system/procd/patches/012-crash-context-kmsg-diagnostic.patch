+#ifdef __aarch64__
+/* Normal context only: capture executable mappings before a possible crash. */
+static void crash_kmsg_maps(void)
+{
+    static const char prefix[] = "<0>X6818_PROCD_MAP ";
+    static const char end[] = "<0>X6818_PROCD_MAP_END\n";
+    static const char truncated[] = "<0>X6818_PROCD_MAP_TRUNCATED\n";
+    static const char unavailable[] = "<0>X6818_PROCD_MAP_UNAVAILABLE\n";
+    int saved_errno = errno;
+    int fd = crash_kmsg_fd;
+    int maps;
+    char input[256], line[384], record[sizeof(prefix) + sizeof(line)];
+    size_t length = 0;
+    unsigned emitted = 0;
+    int overflow = 0, incomplete = 0;
+    ssize_t n;
+
+    if (fd < 0)
+        goto out;
+    maps = open("/proc/self/maps", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (maps < 0) {
+        (void)write(fd, unavailable, sizeof(unavailable) - 1);
+        goto out;
+    }
+
+    while ((n = read(maps, input, sizeof(input))) > 0) {
+        for (ssize_t j = 0; j < n; j++) {
+            char c = input[j];
+            if (c != '\n') {
+                if (length < sizeof(line) - 1)
+                    line[length++] = c;
+                else
+                    overflow = 1;
+                continue;
+            }
+            if (overflow) {
+                incomplete = 1;
+            } else {
+                size_t i = 0;
+                while (i < length && line[i] != ' ')
+                    i++;
+                /* /proc/self/maps: address range, space, then four permission chars. */
+                if (i + 3 < length && line[i + 3] == 'x') {
+                    size_t k = 0;
+                    if (emitted == 32) {
+                        incomplete = 1;
+                        goto done;
+                    }
+                    for (size_t p = 0; p < sizeof(prefix) - 1; p++)
+                        record[k++] = prefix[p];
+                    for (size_t p = 0; p < length; p++)
+                        record[k++] = line[p];
+                    record[k++] = '\n';
+                    if (write(fd, record, k) != (ssize_t)k)
+                        incomplete = 1;
+                    emitted++;
+                }
+            }
+            length = 0;
+            overflow = 0;
+        }
+    }
+    if (n < 0 || length || overflow)
+        incomplete = 1;
+done:
+    (void)close(maps);
+    if (incomplete)
+        (void)write(fd, truncated, sizeof(truncated) - 1);
+    else
+        (void)write(fd, end, sizeof(end) - 1);
+out:
+    errno = saved_errno;
+}
+#endif
 
