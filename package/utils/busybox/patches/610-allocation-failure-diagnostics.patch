+/* Diagnostic-only, best effort: stack formatting and one write, no malloc. */
+static char *oomdiag_text(char *p, char *end, const char *s)
+{
+    while (*s && p < end)
+        *p++ = *s++;
+    return p;
+}
+
+static char *oomdiag_number(char *p, char *end, unsigned long long n,
+                            unsigned int base)
+{
+    static const char digits[] = "0123456789abcdef";
+    char reversed[32];
+    unsigned int i = 0;
+
+    do {
+        reversed[i++] = digits[n % base];
+        n /= base;
+    } while (n && i < sizeof(reversed));
+    while (i && p < end)
+        *p++ = reversed[--i];
+    return p;
+}
+
+void FAST_FUNC bb_oom_diag(const char *op, size_t requested, int saved_errno,
+                           const void *caller)
+{
+    char buf[160];
+    char *p = buf;
+    char *end = buf + sizeof(buf);
+    int old_errno = errno;
+
+    p = oomdiag_text(p, end, "OOMDIAG op=");
+    p = oomdiag_text(p, end, op);
+    p = oomdiag_text(p, end, " requested=");
+    p = oomdiag_number(p, end, requested, 10);
+    p = oomdiag_text(p, end, " errno=");
+    p = oomdiag_number(p, end, (unsigned int)saved_errno, 10);
+    p = oomdiag_text(p, end, " caller=0x");
+    p = oomdiag_number(p, end, (uintptr_t)caller, 16);
+    if (p < end)
+        *p++ = '\n';
+    (void)write(STDERR_FILENO, buf, p - buf);
+    errno = old_errno;
+}
+
 void FAST_FUNC bb_die_memory_exhausted(void)
 {
+    /* Also identify any direct caller outside the instrumented allocators. */
+    bb_oom_diag("bb_die_unknown_size", SIZE_MAX, errno,
+                __builtin_return_address(0));
 	bb_simple_error_msg_and_die(bb_msg_memory_exhausted);
 }
 
