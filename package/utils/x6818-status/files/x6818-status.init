#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1

start_service() {
	[ -c /dev/fb0 ] && [ -c /dev/tty2 ] || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/x6818-status-vt
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/x6818-status.conf
	procd_close_instance
}
