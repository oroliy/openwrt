#!/bin/sh /etc/rc.common

# Bring up the local status VT before networking/firewall services.  A
# userspace service that stalls during boot must not hide the display.
START=18
STOP=01
USE_PROCD=1

start_service() {
	procd_open_instance addresses
	procd_set_param command /usr/sbin/x6818-addresses
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_close_instance

	# Collect by thermal type, independent of probe order or panel presence.
	procd_open_instance temperature
	procd_set_param command /usr/sbin/x6818-temperature
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_close_instance

	[ -c /dev/fb0 ] && [ -c /dev/tty2 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/x6818-status-vt
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/x6818-status.conf
	procd_close_instance
}
