# Set persistent MAC addresses for network interfaces
# Priority:
#   1. /proc/cmdline: macaddr=<mac> / ethaddr=<mac> (manual override)
#   2. Hardware eMMC/SD Card Identification (CID) (hardware-unique & persistent)
#   3. Fallback default MAC

get_mac_from_mmc() {
	local dev=""
	local cid=""
	local hash=""
	local b0 b1 b2 b3 b4 b5

	for dev in /sys/class/block/mmcblk[0-9] /sys/class/block/mmcblk[0-9][0-9]; do
		[ -e "$dev" ] || continue
		if [ -r "$dev/device/cid" ]; then
			cid="$(cat "$dev/device/cid" 2>/dev/null)"
			[ -n "$cid" ] && break
		fi
	done

	[ -z "$cid" ] && return 1

	hash="$(echo -n "$cid" | sha256sum 2>/dev/null | cut -d' ' -f1)"
	[ -n "$hash" ] || return 1

	b0="02"
	b1="$(echo "$hash" | cut -c3-4)"
	b2="$(echo "$hash" | cut -c5-6)"
	b3="$(echo "$hash" | cut -c7-8)"
	b4="$(echo "$hash" | cut -c9-10)"
	b5="$(echo "$hash" | cut -c11-12)"

	echo "${b0}:${b1}:${b2}:${b3}:${b4}:${b5}"
}

set_mac_from_cmdline() {
	local eth_mac=""
	local wifi_mac=""
	local bt_mac=""

	for arg in $(cat /proc/cmdline); do
		case "$arg" in
			macaddr=*|ethaddr=*)
				eth_mac="${arg#*=}"
				;;
			wifimac=*|wlanmac=*)
				wifi_mac="${arg#*=}"
				;;
			btmac=*)
				bt_mac="${arg#*=}"
				;;
		esac
	done

	if [ -z "$eth_mac" ]; then
		eth_mac="$(get_mac_from_mmc)"
		[ -z "$eth_mac" ] && eth_mac="00:e2:1c:ba:e8:60"
	fi

	if [ -n "$eth_mac" ] && [ -d /sys/class/net/eth0 ]; then
		echo "Applying persistent MAC $eth_mac to eth0..."
		ip link set dev eth0 down 2>/dev/null || true
		ip link set dev eth0 address "$eth_mac" 2>/dev/null || true
		ip link set dev eth0 up 2>/dev/null || true
	fi

	# Generate udev or hotplug rules for dynamic devices (wlan0 / hci0)
	if [ -n "$wifi_mac" ]; then
		mkdir -p /etc/hotplug.d/net
		cat <<- 'RULE' > /etc/hotplug.d/net/10-wifi-mac
		[ "$ACTION" = "add" ] && [ "$INTERFACE" = "wlan0" ] && {
			ip link set dev wlan0 down
			ip link set dev wlan0 address "$wifi_mac"
			ip link set dev wlan0 up
		}
		RULE
		sed -i "s|\$wifi_mac|$wifi_mac|g" /etc/hotplug.d/net/10-wifi-mac
	fi
}

boot_hook_add preinit_main set_mac_from_cmdline
