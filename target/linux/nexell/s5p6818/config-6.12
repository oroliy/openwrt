# x6818 (Nexell S5P6818) target kernel config
# Derived from the committed linux-lts x6818_defconfig @ec13ac219.
# The three explicit disables below carry hardware-verified comments
# from the board bring-up; do not drop them.

CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_NEXELL=y
CONFIG_NEXELL_S5P6818_NO_CROSS_CLUSTER_SEV=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_AEABI=y
# The x6818 boot firmware and secondary-CPU trampoline are little-endian.
# Set the ARM endian choice explicitly; an unset choice produced a BE8 kernel.
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_HIGHMEM=y
CONFIG_VMSPLIT_2G=y
# The generic armv7 config selects the 3G split; a kconfig choice needs the
# other members unset explicitly or the merged config keeps VMSPLIT_3G.
# CONFIG_VMSPLIT_3G is not set
CONFIG_VFP=y
# The current Nexell stop_machine path cannot safely change early section
# permissions while all A53 CPUs are online.
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
# IPv6 SIT init currently deadlocks during x6818 netdevice registration.
# IPv4 networking does not require this tunnel driver on the board.
# CONFIG_IPV6_SIT is not set
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_NEXELL=y
# USB is outside the RAM-initramfs v1 acceptance scope.
# CONFIG_PHY_NEXELL_USB2 is not set
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VIDEO_NEXELL_S5P6818=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_NEXELL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The U-Boot load address is 0x48000000, which is outside the first 128 MiB
# of the board's RAM at 0x40000000.  Do not infer PHYS_OFFSET from zImage PC.
# CONFIG_AUTO_ZRELADDR is not set
CONFIG_PHYS_OFFSET=0x40000000
CONFIG_COMMON_CLK_NEXELL=y
CONFIG_RESET_NEXELL=y
CONFIG_NEXELL_TIMER=y
CONFIG_WATCHDOG=y
CONFIG_NEXELL_WDT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_UARTS=6
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_PINCTRL_NEXELL=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_CMDLINE="console=ttySAC0,115200n8 earlycon=s5p6818,mmio,0xc00a1000"
CONFIG_CMDLINE_FROM_BOOTLOADER=y

# Symbols that the OpenWrt generic config leaves unresolved (they would
# otherwise show as (NEW) prompts during kernel syncconfig). Values below
# mirror the linux-lts x6818 acceptance-build resolutions; NEON is required
# by the neon-vfpv4 userspace ABI and must override its default-off here.
CONFIG_ARM_THUMB=y
CONFIG_HARDEN_BRANCH_PREDICTOR=y
CONFIG_CACHE_L2X0=y
CONFIG_SMP_ON_UP=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_HIGHPTE=y
CONFIG_ZBOOT_ROM_TEXT=0x0
CONFIG_ZBOOT_ROM_BSS=0x0
CONFIG_NEON=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_RPS=y
CONFIG_RFS_ACCEL=y
CONFIG_NET_FLOW_LIMIT=y
# CONFIG_MMC_DW_BLUEFIELD is not set
# CONFIG_MMC_DW_EXYNOS is not set
# CONFIG_MMC_DW_HI3798CV200 is not set
# CONFIG_MMC_DW_HI3798MV200 is not set
# CONFIG_MMC_DW_K3 is not set
CONFIG_UNWINDER_ARM=y
