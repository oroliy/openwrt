+	};
+
+	cci: cci@e0090000 {
+		compatible = "arm,cci-400";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		reg = <0xe0090000 0x6000>;
+		ranges = <0x0 0xe0090000 0x6000>;
