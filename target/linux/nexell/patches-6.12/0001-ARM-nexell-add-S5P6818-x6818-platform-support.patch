@@ -0,0 +1,75 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/timer/nexell,s5p6818-timer.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nexell S5P6818 Timer
+
+maintainers:
+  - liy <liygfg@gmail.com>
+
+description: |
+  The S5P6818 timer block provides a 32-bit down-counter driven by a
+  prescaled bus clock.  Linux uses it as both clocksource and clockevent.
+
+properties:
+  compatible:
+    const: nexell,s5p6818-timer
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: timer
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: timer
+
+  nexell,pclk-frequency:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: bus PCLK in Hz that feeds the timer prescaler
+
+  clock-frequency:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: resulting timer tick rate in Hz after the prescaler
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - nexell,pclk-frequency
+  - clock-frequency
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/clock/nexell,s5p6818-clock.h>
+    #include <dt-bindings/reset/nexell,s5p6818-reset.h>
+    timer@c0017000 {
+        compatible = "nexell,s5p6818-timer";
+        reg = <0xc0017000 0x1000>;
+        interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&clocks NEXELL_CLK_TIMER0>;
+        clock-names = "timer";
+        resets = <&nexell_reset RESET_ID_TIMER>;
+        reset-names = "timer";
+        nexell,pclk-frequency = <200000000>;
+        clock-frequency = <10000000>;
+    };
