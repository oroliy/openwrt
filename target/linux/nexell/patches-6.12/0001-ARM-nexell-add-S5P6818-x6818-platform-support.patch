@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/nexell,s5p6818-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Nexell S5P6818 Clock Controller
+
+maintainers:
+  - liy <liygfg@gmail.com>
+
+description: |
+  The S5P6818 clock controller generates the peripheral clocks from the
+  external XIN oscillator.  Clock identifiers are defined in
+  include/dt-bindings/clock/nexell,s5p6818-clock.h.
+
+properties:
+  compatible:
+    const: nexell,s5p6818-clk
+
+  reg:
+    minItems: 13
+    maxItems: 13
+
+  reg-names:
+    items:
+      - const: clkpwr
+      - const: uart0
+      - const: timer0
+      - const: timer1
+      - const: sdmmc0
+      - const: sdmmc1
+      - const: sdmmc2
+      - const: gmac
+      - const: usbhost
+      - const: mipi
+      - const: i2c0
+      - const: i2c1
+      - const: i2c2
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: xin
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@c0010000 {
+        compatible = "nexell,s5p6818-clk";
+        reg = <0xc0010000 0x400>,
+              <0xc00a9000 0x1000>, <0xc00b9000 0x1000>,
+              <0xc00bb000 0x1000>, <0xc00c5000 0x1000>,
+              <0xc00cc000 0x1000>, <0xc00cd000 0x1000>,
+              <0xc00c8000 0x1000>, <0xc006b000 0x1000>,
+              <0xc00ca000 0x1000>, <0xc00ae000 0x1000>,
+              <0xc00af000 0x1000>, <0xc00b0000 0x1000>;
+        reg-names = "clkpwr", "uart0", "timer0", "timer1",
+                    "sdmmc0", "sdmmc1", "sdmmc2", "gmac",
+                    "usbhost", "mipi", "i2c0", "i2c1", "i2c2";
+        clocks = <&refclk>;
+        clock-names = "xin";
+        #clock-cells = <1>;
+    };
