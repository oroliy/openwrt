diff --git a/Documentation/devicetree/bindings/clock/nexell,s5p6818-clock.yaml b/Documentation/devicetree/bindings/clock/nexell,s5p6818-clock.yaml
new file mode 100644
index 000000000..3dc36f378
--- /dev/null
