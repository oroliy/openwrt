From 7129a20b0ed0bdd30935a5e525a45c2f691032d1 Mon Sep 17 00:00:00 2001
From: liy <12697416+oroliy@users.noreply.github.com>
Date: Thu, 3 Sep 2026 22:26:26 +0800
Subject: [PATCH 05/11] usb: host: ohci-nexell: skip inaccessible shutdown MMIO
 on S5P6818

S5P6818 OHCI controller registers become inaccessible during system reboot
shutdown, hanging generic usb_hcd_platform_shutdown(). Implement custom
nexell_ohci_shutdown() to skip HCD MMIO and allow clean architectural
reboot via PSCI/watchdog.
---
 drivers/usb/host/ohci-nexell.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/host/ohci-nexell.c b/drivers/usb/host/ohci-nexell.c
index 0804832f0..b1705e450 100644
--- a/drivers/usb/host/ohci-nexell.c
+++ b/drivers/usb/host/ohci-nexell.c
@@ -100,6 +100,15 @@ static void nexell_ohci_remove(struct platform_device *pdev)
 	usb_put_hcd(hcd);
 }
 
+static void nexell_ohci_shutdown(struct platform_device *pdev)
+{
+	/*
+	 * S5P6818 OHCI registers become inaccessible during system reboot
+	 * shutdown. Skip generic HCD MMIO access and let the platform reset
+	 * reinitialize the controller on the next boot.
+	 */
+}
+
 static const struct of_device_id nexell_ohci_ids[] = {
 	{ .compatible = "nexell,s5p6818-ohci" },
 	{ }
@@ -109,7 +118,7 @@ MODULE_DEVICE_TABLE(of, nexell_ohci_ids);
 static struct platform_driver nexell_ohci_driver = {
 	.probe = nexell_ohci_probe,
 	.remove_new = nexell_ohci_remove,
-	.shutdown = usb_hcd_platform_shutdown,
+	.shutdown = nexell_ohci_shutdown,
 	.driver = {
 		.name = "nexell-ohci",
 		.of_match_table = nexell_ohci_ids,
-- 
