From 7b323677e43fa6e6ca3ad55e3a6d78371b5ff00c Mon Sep 17 00:00:00 2001
From: liy <liygfg@gmail.com>
Date: Sun, 31 Aug 2026 00:00:00 +0800
Subject: [PATCH] arm64: nexell: add S5P6818 x6818 product port

Add the AArch64 platform, PSCI device tree, shared ARM/ARM64 driver
selection, timer fallback, OHCI shutdown fix, and S5P6818-scoped
queued-lock polling workaround.

This patch is generated from the reviewed linux-lts range
ec13ac219..7b323677e.

Signed-off-by: liy <liygfg@gmail.com>
---
diff --git a/MAINTAINERS b/MAINTAINERS
index 32d166b10..cc3ca28be 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2000,6 +2000,8 @@ F:	Documentation/devicetree/bindings/watchdog/nexell,s5p6818-wdt.yaml
 F:	arch/arm/boot/dts/nexell/
 F:	arch/arm/configs/x6818_defconfig
 F:	arch/arm/mach-nexell/
+F:	arch/arm64/boot/dts/nexell/
+F:	arch/arm64/configs/x6818_arm64_defconfig
 F:	drivers/clk/nexell/
 F:	drivers/clocksource/timer-nexell.c
 F:	drivers/mmc/host/dw_mmc-nexell.c
@@ -2007,6 +2009,7 @@ F:	drivers/net/ethernet/stmicro/stmmac/dwmac-nexell.c
 F:	drivers/phy/nexell/
 F:	drivers/pinctrl/nexell/
 F:	drivers/reset/reset-nexell.c
+F:	drivers/soc/nexell/
 F:	drivers/usb/host/ehci-nexell.c
 F:	drivers/usb/host/ohci-nexell.c
 F:	drivers/video/nexell/
diff --git a/arch/arm/mach-nexell/Kconfig b/arch/arm/mach-nexell/Kconfig
index b2eae4750..048ef2ede 100644
--- a/arch/arm/mach-nexell/Kconfig
+++ b/arch/arm/mach-nexell/Kconfig
@@ -12,22 +12,6 @@ config ARCH_NEXELL
 	select OF
 	select PINCTRL
 	select RESET_CONTROLLER
+	select SOC_NEXELL_S5P6818
 	help
 	  Support for the Nexell S5P6818 ARM Cortex-A53 SoC.
-
-config NEXELL_S5P6818_NO_CROSS_CLUSTER_SEV
-	bool "Poll S5P6818 ARM lock waiters when cross-cluster SEV is unavailable"
-	depends on ARCH_NEXELL && SMP
-	default y
-	help
-	  The S5P6818 does not deliver a CPU event generated by SEV to the
-	  other Cortex-A53 cluster. A lock waiter using WFE can therefore
-	  remain asleep after a lock owner in the other cluster releases the
-	  lock.
-
-	  Select this option to enable the S5P6818 runtime quirk. The polling
-	  paths are enabled only after the S5P6818 machine is identified, so a
-	  multi-platform kernel booted on another ARM SoC retains WFE. Unlock
-	  still executes SEV for same-cluster waiters. Polling avoids deadlock
-	  at the cost of additional power and interconnect traffic while locks
-	  are contended.
diff --git a/arch/arm/mach-nexell/s5p6818.c b/arch/arm/mach-nexell/s5p6818.c
index 5aa2de573..6fb7e9de2 100644
--- a/arch/arm/mach-nexell/s5p6818.c
+++ b/arch/arm/mach-nexell/s5p6818.c
@@ -18,10 +18,6 @@
 
 static void __iomem *s5p6818_clkpwr;
 
-#ifdef CONFIG_NEXELL_S5P6818_NO_CROSS_CLUSTER_SEV
-bool nexell_s5p6818_poll_lock_wait;
-#endif
-
 static void s5p6818_restart(enum reboot_mode mode, const char *cmd)
 {
 	u32 value;
diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 6c6d11536..65a7279d2 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -1,6 +1,22 @@
 # SPDX-License-Identifier: GPL-2.0-only
 menu "Platform selection"
 
+config ARCH_NEXELL_S5P6818
+	bool "Nexell S5P6818 platforms"
+	select ARM_CCI400_COMMON
+	select ARM_GIC
+	select ARM_PSCI
+	select COMMON_CLK
+	select HAVE_ARM_ARCH_TIMER
+	select PINCTRL
+	select RESET_CONTROLLER
+	select SOC_NEXELL_S5P6818
+	help
+	  Enable support for AArch64 systems based on the Nexell S5P6818
+	  Cortex-A53 SoC. CPU power management is provided by TF-A through
+	  PSCI; the AArch32 Nexell holding-pen implementation is not used.
+	  This includes the x6818 product board.
+
 config ARCH_ACTIONS
 	bool "Actions Semi Platforms"
 	select OWL_TIMER
diff --git a/arch/arm64/boot/dts/Makefile b/arch/arm64/boot/dts/Makefile
index 21cd3a87f..a8651ef2e 100644
--- a/arch/arm64/boot/dts/Makefile
+++ b/arch/arm64/boot/dts/Makefile
@@ -20,6 +20,7 @@ subdir-y += lg
 subdir-y += marvell
