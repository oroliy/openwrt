diff --git a/drivers/soc/nexell/Kconfig b/drivers/soc/nexell/Kconfig
new file mode 100644
index 000000000..4c8617c46
--- /dev/null
+++ b/drivers/soc/nexell/Kconfig
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config SOC_NEXELL_S5P6818
+	bool
+	help
+	  Common SoC selection for the Nexell S5P6818. Architecture platform
+	  code selects this symbol so shared clock, pinctrl, reset, timer, MMC,
+	  network, USB, watchdog, serial, and display drivers can be built for
+	  either AArch32 or AArch64.
+
+config NEXELL_S5P6818_NO_CROSS_CLUSTER_SEV
+	bool "Poll S5P6818 lock waiters when cross-cluster SEV is unavailable"
+	depends on SOC_NEXELL_S5P6818 && SMP
+	default y
+	help
+	  The S5P6818 does not deliver a CPU event generated by SEV to the
+	  other Cortex-A53 cluster. A lock waiter using WFE can therefore
+	  remain asleep after a lock owner in the other cluster releases the
+	  lock.
+
+	  Select this option to use polling only in queued spinlock, queued
+	  rwlock, and MCS wait paths after an S5P6818 machine is identified.
+	  Unlock-side event instructions and non-lock low-power WFE paths are
+	  unchanged.
