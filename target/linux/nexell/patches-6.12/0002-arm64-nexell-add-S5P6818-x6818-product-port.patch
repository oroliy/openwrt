diff --git a/arch/arm/mach-nexell/Kconfig b/arch/arm/mach-nexell/Kconfig
index b2eae4750..048ef2ede 100644
--- a/arch/arm/mach-nexell/Kconfig
+++ b/arch/arm/mach-nexell/Kconfig
@@ -12,22 +12,6 @@ config ARCH_NEXELL
 	select OF
 	select PINCTRL
 	select RESET_CONTROLLER
+	select SOC_NEXELL_S5P6818
 	help
 	  Support for the Nexell S5P6818 ARM Cortex-A53 SoC.
-
-config NEXELL_S5P6818_NO_CROSS_CLUSTER_SEV
-	bool "Poll S5P6818 ARM lock waiters when cross-cluster SEV is unavailable"
-	depends on ARCH_NEXELL && SMP
-	default y
-	help
-	  The S5P6818 does not deliver a CPU event generated by SEV to the
-	  other Cortex-A53 cluster. A lock waiter using WFE can therefore
-	  remain asleep after a lock owner in the other cluster releases the
-	  lock.
-
-	  Select this option to enable the S5P6818 runtime quirk. The polling
-	  paths are enabled only after the S5P6818 machine is identified, so a
-	  multi-platform kernel booted on another ARM SoC retains WFE. Unlock
-	  still executes SEV for same-cluster waiters. Polling avoids deadlock
-	  at the cost of additional power and interconnect traffic while locks
-	  are contended.
